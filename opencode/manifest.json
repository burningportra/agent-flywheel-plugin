  "plugin": {
    "name": "agent-flywheel",
    "template": "opencode/plugins/agent-flywheel.js",
    "source": "hooks/",
    "target": "plugins/agent-flywheel.js",
    "kind": "plugin",
    "transformProfile": "plugin",
    "note": "Checked-in template (T2). FLYWHEEL_ROOT is a typed sentinel the T3 renderer replaces with JSON.stringify(repoRoot). Ports hooks/hooks.json — see hookCoverage for the authoritative map."
  },
  "hookCoverage": {
    "note": "Every entry in hooks/hooks.json maps to a plugin handler here. checkHookCoverage() fails (hook_uncovered / hook_stale) when hooks.json gains or removes a hook without a matching manifest update. Identity = <claudeHook>:<matcher|*>.",
    "source": "hooks/hooks.json",
    "pluginTemplate": "opencode/plugins/agent-flywheel.js",
    "hooks": [
      {
        "claudeHook": "SessionStart",
        "matcher": null,
        "opencodeEvent": "session.created",
        "handler": "event",
        "behavior": "version banner log, resume-warning toast, missing-CLI dep-check toast"
      },
      {
        "claudeHook": "PreToolUse",
        "matcher": "Bash",
        "opencodeEvent": "tool.execute.before",
        "handler": "tool.execute.before",
        "behavior": "Agent Mail activity-lock guard (MUTATING_DOCTOR / DELETE_ACTIVITY_LOCK regexes; FLYWHEEL_ALLOW_AM_DOCTOR=1 break-glass)"
      },
      {
        "claudeHook": "Stop",
        "matcher": null,
        "opencodeEvent": "session.idle",
        "handler": "event",
        "behavior": "release Agent Mail file reservations"
      },
      {
        "claudeHook": "SubagentStop",
        "matcher": null,
        "opencodeEvent": "session.idle",
        "handler": "event",
        "behavior": "release Agent Mail file reservations (shares the session.idle handler)"
      },
      {
        "claudeHook": "PostToolUse",
        "matcher": "flywheel_approve_beads",
        "opencodeEvent": "tool.execute.after",
        "handler": "tool.execute.after",
        "behavior": "bead-approval progress toast"
      }
    ]
  },
  "dependencyClassification": {
    "grill-with-docs": {
      "class": "mcp-bundle",
      "accessVia": "mcp",
      "resolvesVia": "flywheel_get_skill({ name: \"agent-flywheel:grill-with-docs\" })",
      "reason": "Ships in the flywheel skills bundle (mcp-server/dist/skills.bundle.json) but is NOT a managed native skill dir. Resolves ONLY through the MCP bundle load; a native skill(name: \"grill-with-docs\") or /grill-with-docs slash delegation is a closure hole and MUST fail (acceptance #5)."
    }
  },
