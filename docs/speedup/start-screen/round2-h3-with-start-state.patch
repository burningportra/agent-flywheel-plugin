+        history: 0,
+      });
+      if (res.isError) return null;
+      return res.content[0]?.text ?? null;
+    } catch {
+      return null;
+    }
+  };
+
+  const [doctor, observe, sessionLearnings, realityCheck] = await Promise.all([
+    doctorPromise,
+    observePromise,
+    memoryQuery("session learnings flywheel"),
+    memoryQuery("reality-check session learnings gap analysis"),
+  ]);
+
+  return {
+    doctor,
+    observe,
+    memory: {
+      sessionLearnings,
+      realityCheck,
+    },
