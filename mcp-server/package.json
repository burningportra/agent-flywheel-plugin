{
  "name": "agent-flywheel-mcp",
  "version": "3.20.0",
  "description": "MCP server for agent-flywheel — state + CLI glue for the agentic coding flywheel",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.scripts.json && npm run build:bundle && npm run build:schemas",
    "build:bundle": "node dist/scripts/build-skills-bundle.js",
    "build:schemas": "node dist/scripts/emit-schemas.js",
    "check:skills-bundle": "node dist/scripts/check-skills-bundle.js",
    "verify:error-meta": "node scripts/verify-error-meta.mjs",
    "bead-viewer": "node dist/scripts/bead-viewer.js",
    "dead-code": "node scripts/reachability.mjs",
    "prompt-budget": "tsx scripts/prompt-budget.ts",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint:skill": "node dist/scripts/lint-skill-dir.js --dir ../skills/start --baseline .lintskill-baseline.json",
    "lint:skill:json": "tsx scripts/lint-skill-dir.ts --dir ../skills/start --ci --format json",
    "lint:skill:update-baseline": "tsx scripts/lint-skill-dir.ts --dir ../skills/start --update-baseline --baseline .lintskill-baseline.json",
    "lint:skill:update-tone-baseline": "tsx scripts/update-tone-baseline.ts",
    "lint:skill:update-manifest": "tsx scripts/lint-skill.ts --update-manifest",
    "eval:start": "tsx scripts/eval/run-eval.ts",
    "version-sync": "node scripts/version-sync.mjs",
    "version-sync:check": "node scripts/version-sync.mjs --check"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@sinclair/typebox": "^0.34.0",
    "execa": "^9.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^29.1.0",
    "remark-parse": "^11.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "unified": "^11.0.0",
    "vitest": "^2.0.0"
  }
}
