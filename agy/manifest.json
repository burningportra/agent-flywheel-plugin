{
  "schemaVersion": 1,
  "kind": "agy-port-manifest",
  "generatedNote": "Hand-authored source of truth for bead agent-flywheel-plugin-dm1. The Claude Code plugin repo remains the source of truth; this manifest owns the AGY mirror boundary. Discovery is DYNAMIC: skills[]/commands[] are cross-checked against the live tree (inventory_missing / inventory_unclassified), same contract as opencode/manifest.json.",
  "repoSourceOfTruth": true,
  "target": "~/.gemini/antigravity/plugins/agent-flywheel",
  "rulesMaxBytes": 24000,
  "skillBodyMaxBytes": 24000,
  "discovery": {
    "skillDirPattern": "^(flywheel-.+|start)$",
    "commandFilePattern": "^(flywheel-.+|start)\\.md$",
    "skillsRoot": "skills",
    "commandsRoot": "commands",
    "note": "Managed iff the dir matches skillDirPattern and contains SKILL.md, or the file matches commandFilePattern. Non-flywheel skills are outside the ownership boundary."
  },
  "pluginJson": {
    "source": "agy/plugin.json",
    "target": "plugin.json",
    "mirrorCopy": ".agy-plugin/plugin.json",
    "allowedFields": [
      "name",
      "displayName",
      "version",
      "description",
      "logo",
      "suggestedPrompts",
      "disabled"
    ],
    "note": "agy plugin validate --strict rejects unknown fields; plugin.json carries EXACTLY the 7 allowed fields. A byte-identical copy lands at .agy-plugin/plugin.json for directory-scoped consumers."
  },
  "logo": {
    "source": "agy/logo.svg",
    "target": "logo.svg"
  },
  "mcp": {
    "source": "agy/.mcp.json",
    "target": "mcp_config.json",
    "rootToken": "${PLUGIN_ROOT}",
    "serverName": "agent-flywheel",
    "note": "AGY loads mcp_config.json (its strict validator rejects .mcp.json as a Claude-Code-only name). ${PLUGIN_ROOT} is rewritten to the absolute repo root at render time; the emitted server entry runs node <repo>/mcp-server/dist/server.js with CLAUDE_PLUGIN_ROOT=<repo>."
  },
  "rules": {
    "source": "agy/rules/AGENTS.md",
    "target": "rules/AGENTS.md",
    "maxBytes": 24000,
    "note": "AGY silently truncates rule files above 24,000 bytes; the authored file stays <= 20,000."
  },
  "hooks": [
    {
      "source": {
        "event": "PreToolUse",
        "matcher": "Bash",
        "if": [
          "Bash(*doctor*)",
          "Bash(*DOCTOR*)",
          "Bash(*activity.lock*)"
        ],
        "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/agent-mail-guard.js"
      },
      "event": "PreToolUse",
      "matcher": "run_command",
      "name": "agent-flywheel-guard",
      "wrapper": "hooks/agent-mail-guard.sh",
      "portable": true,
      "note": "AGY has no if-filter; the wrapper applies the guard patterns to toolCall.args.CommandLine itself and prints {\"decision\":\"allow\"} or {\"decision\":\"deny\",\"reason\":...}."
    },
    {
      "source": {
        "event": "SessionStart",
        "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/_run-hook.sh node ${CLAUDE_PLUGIN_ROOT}/hooks/startup.js"
      },
      "event": "SessionStart",
      "name": "agent-flywheel-startup",
      "wrapper": "hooks/startup.sh",
      "portable": true,
      "note": "Wrapper runs the repo startup.js, wraps its stdout as injectSteps[0].systemMessage (capped at 8 KB), and always prints valid JSON."
    },
    {
      "source": {
        "event": "Stop",
        "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/_run-hook.sh node ${CLAUDE_PLUGIN_ROOT}/hooks/agent-mail-guard.js --release-reservations"
      },
      "event": "Stop",
      "name": "agent-flywheel-stop",
      "wrapper": "hooks/release-reservations.sh",
      "portable": true,
      "note": "Releases Agent Mail file reservations and prints {}; never returns decision:\"continue\" so it cannot trap the loop."
    },
    {
      "source": {
        "event": "PostToolUse",
        "matcher": "flywheel_approve_beads",
        "command": "echo Bead approval processed..."
      },
      "event": null,
      "portable": false,
      "reason": "AGY PostToolUse must print a JSON object (echo prints plain text) and the AGY-side MCP tool name is not known at sync time."
    },
    {
      "source": {
        "event": "SubagentStop",
        "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/_run-hook.sh node ${CLAUDE_PLUGIN_ROOT}/hooks/agent-mail-guard.js --release-reservations"
      },
      "event": null,
      "portable": false,
      "reason": "AGY has no SubagentStop event; the Stop wrapper covers release."
    }
  ],
